<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <!-- Vibrant Brand Gradient (Orange to Sunset Pink) -->
    <linearGradient id="brandGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ea580c" />
      <stop offset="100%" stop-color="#f97316" />
    </linearGradient>
    <!-- Slate Glow / Background Shadow -->
    <filter id="glow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#ea580c" flood-opacity="0.15" />
    </filter>
  </defs>
  
  <!-- Outer smooth circular-squircle background of the app icon -->
  <rect x="5" y="5" width="90" height="90" rx="26" fill="#0f172a" />
  
  <!-- Content Group with drop shadow for premium look -->
  <g filter="url(#glow)">
    <!-- Upward Trend Grid Backing (Subtle dots) -->
    <circle cx="35" cy="45" r="1.5" fill="#334155" opacity="0.4" />
    <circle cx="50" cy="45" r="1.5" fill="#334155" opacity="0.4" />
    <circle cx="65" cy="45" r="1.5" fill="#334155" opacity="0.4" />
    <circle cx="35" cy="60" r="1.5" fill="#334155" opacity="0.4" />
    <circle cx="50" cy="60" r="1.5" fill="#334155" opacity="0.4" />
    <circle cx="65" cy="60" r="1.5" fill="#334155" opacity="0.4" />

    <!-- Trend line underlay - symbolizing acceleration of search visibility -->
    <path d="M 28 65 L 44 48 L 56 56 L 72 32" stroke="#ea580c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" opacity="0.3" />

    <!-- Futuristic Rocket / Arrow Symbolizing Acelera SEO -->
    <!-- Centered carefully inside the container -->
    <path d="M 50 20 
             C 54 36, 68 46, 68 62 
             C 68 72, 60 76, 50 76 
             C 40 76, 32 72, 32 62 
             C 32 46, 46 36, 50 20 Z" 
          fill="url(#brandGrad)" />

    <!-- inner highlight element representing high-performance light core of the rocket -->
    <path d="M 50 32 
             C 52 44, 60 52, 60 62 
             C 60 67, 56 70, 50 70 
             C 44 70, 40 67, 40 62 
             C 40 52, 48 44, 50 32 Z" 
          fill="#ffffff" />
          
    <!-- Small tech cross symbol representing search optimization precision inside the core -->
    <path d="M 50 48 L 50 56 M 46 52 L 54 52" stroke="#ea580c" stroke-width="2.5" stroke-linecap="round" />
  </g>
</svg>
