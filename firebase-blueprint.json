{
  "entities": {
    "blog_posts": {
      "title": "Blog Post",
      "description": "Artigos do blog da agência ou dos clientes",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "coverImage": { "type": "string" },
        "status": { "type": "string", "enum": ["Rascunho", "Planejado", "Aguardando Aprovação", "Publicado"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content", "category"]
    },
    "blog_categories": {
      "title": "Blog Category",
      "description": "Categorias para organizar os artigos do blog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "isProtected": { "type": "boolean", "description": "Se true, não pode ser deletada (ex: Geral)" }
      },
      "required": ["name", "slug"]
    },
    "clients": {
      "title": "Client",
      "description": "Clientes da agência",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "clientEmail": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "billingDay": { "type": "string" },
        "contractStart": { "type": "string" },
        "monthlyPosts": { "type": "number" },
        "monthlyBacklinks": { "type": "number" },
        "active": { "type": "boolean" },
        "agencyUid": { "type": "string" },
        "logoUrl": { "type": "string" },
        "lastPaymentMonth": { "type": "string", "description": "Formato YYYY-MM" },
        "packageValue": { "type": "number" },
        "packageName": { "type": "string" },
        "status": { "type": "string", "enum": ["Ativo", "Cancelado"] }
      },
      "required": ["name", "clientEmail"]
    },
    "payments": {
      "title": "Payment",
      "description": "Registros de pagamentos feitos pelos clientes",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["Mensalidade", "Setup", "Serviço Avulso", "Consultoria"] },
        "status": { "type": "string", "enum": ["confirmado", "pendente"], "description": "Status do pagamento" },
        "paymentMonth": { "type": "string", "description": "Mês de referência (YYYY-MM)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "agencyUid": { "type": "string" }
      },
      "required": ["clientId", "amount", "paymentDate"]
    },
    "backlinks": {
      "title": "Backlink",
      "description": "Registros de link building",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "targetUrl": { "type": "string" },
        "anchor": { "type": "string" },
        "status": { "type": "string", "enum": ["Rascunho", "Planejado", "Publicado"] },
        "publishedUrl": { "type": "string" },
        "targetMonth": { "type": "string" },
        "agencyUid": { "type": "string" }
      },
      "required": ["title", "clientName", "targetUrl"]
    },
    "notifications": {
      "title": "Notification",
      "description": "Alertas e avisos para clientes ou agência",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID do destinatário" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "clientEmail": { "type": "string", "description": "Filtro adicional para clientes" },
        "category": { "type": "string", "description": "Ex: pagamento, aprovação, relatório" }
      },
      "required": ["userId", "title", "message", "read"]
    },
    "contacts": {
      "title": "Contact",
      "description": "Mensagens de contato do site",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "audit_leads": {
      "title": "Audit Lead",
      "description": "Leads gerados pela ferramenta de auditoria",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "url"]
    },
    "seo_pages": {
      "title": "SEO Page Metadata",
      "description": "Configurações customizadas de metadados para URLs específicas do site",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "agencyUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "title", "createdAt", "agencyUid"]
    },
    "settings": {
      "title": "Global Settings",
      "description": "Configurações e ativos visuais globais (logo, favicon e imagens de layout)",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "defaultTitle": { "type": "string" },
        "defaultDescription": { "type": "string" },
        "defaultKeywords": { "type": "string" },
        "images": { "type": "object", "description": "Mapeamento chave-valor de ativos de imagem de layout" }
      }
    }
  },
  "firestore": {
    "seo_pages": {
      "schema": "seo_pages",
      "description": "Coleção de metadados e tags de SEO por rota/URL"
    },
    "settings": {
      "schema": "settings",
      "description": "Coleção de configurações globais e imagens de layout"
    },
    "blog_posts": {
      "schema": "blog_posts",
      "description": "Coleção principal de artigos"
    },
    "blog_categories": {
      "schema": "blog_categories",
      "description": "Coleção de categorias gerenciáveis"
    },
    "clients": {
      "schema": "clients",
      "description": "Coleção de clientes da agência"
    },
    "payments": {
      "schema": "payments",
      "description": "Coleção de registros de pagamentos"
    },
    "backlinks": {
      "schema": "backlinks",
      "description": "Coleção de registros de link building"
    },
    "notifications": {
      "schema": "notifications",
      "description": "Coleção de alertas e avisos"
    },
    "contacts": {
      "schema": "contacts",
      "description": "Coleção de mensagens de contato"
    },
    "audit_leads": {
      "schema": "audit_leads",
      "description": "Coleção de leads de auditoria"
    }
  }
}
